# Copy to .env and replace the example values on your Windows computer.
# SQL authentication only. Use the same server/database/login that work in SSMS.
# Supply the host alone here (no backslash instance or comma port).
SQLSERVER_HOST=YOUR-SERVER-NAME
SQLSERVER_DATABASE=TaskManagement_Test
SQLSERVER_USER=taskmanagement_app
# Type your actual password locally inside quotes. Do not upload this .env file.
SQLSERVER_PASSWORD=

# Choose ONE connection method. Ask your SQL administrator for the TCP port.
SQLSERVER_PORT=1433
# For a named instance, empty SQLSERVER_PORT and set SQLSERVER_INSTANCE instead.
SQLSERVER_INSTANCE=

# Encryption is always enabled. For a trusted production certificate keep false.
# Local testing with a known self-signed server may require true.
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
