# Copy to backend/.env and fill in the values locally. backend/.env is git-ignored and must never be committed.
# The React app never receives any of these values.

# --- Django
# A long random value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Keep it unchanged once set: it also protects the stored Telegram bot token (change it = enter the token again).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=no
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Browser origins allowed to send changes: Django itself and the Vite dev server (npm run dev). Add the React app's
# origin here only if it is served from a different address (VITE_API_BASE_URL in source/.env).
DJANGO_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Set to yes once the site is served over HTTPS (hosting stage).
SESSION_COOKIE_SECURE=no
# The first administrator can be created only from this computer unless this is yes.
DJANGO_ALLOW_REMOTE_SETUP=no
DJANGO_LOG_LEVEL=INFO

# --- Microsoft SQL Server (least-privilege application login; never sa or an administrator account)
DB_ENGINE=mssql
DB_HOST=SERVERSYSTEM
# Leave empty for the default instance/port; or e.g. 1433, or put a named instance in DB_HOST (SERVERSYSTEM\INSTANCE).
DB_PORT=
DB_NAME=TaskManagement_Production
DB_USER=taskmanagement_app
# Type the password here yourself. It is read only by Django.
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# yes while SERVERSYSTEM uses a self-signed certificate (typical inside an office network).
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONN_MAX_AGE=60
# Schema changes use the migration login: `python manage.py migrate_database` asks for its password and does not store it.
DB_MIGRATION_USER=taskmanagement_migrator

# --- Application
COMPANY_ID=default
# Where the built React app is (npm run build in source/). The default is ../source/local-test/public.
# FRONTEND_DIR=
# Groups and the Google Sheets connection are not part of this deployment (Stage 1 decision A).
HIDDEN_FUNCTIONS=tasks.groups,admin.integrations
# The public HTTPS address once the system is hosted (Telegram Mini App links). Leave empty for now.
PUBLIC_URL=
# same-origin (default). Use same-site only when the React app is served from another address of the same site.
CROSS_ORIGIN_RESOURCE_POLICY=same-origin
# Optional: a separate key for the stored Telegram bot token instead of one derived from DJANGO_SECRET_KEY.
# TELEGRAM_TOKEN_KEY=
