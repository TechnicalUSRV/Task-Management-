# Copy to backend/.env and fill in the password locally. backend/.env is git-ignored and must never be committed.

# --- Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=no
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Origins allowed to send changes (the Vite dev server and Django itself).
DJANGO_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=no

# --- Microsoft SQL Server (least-privilege application login; never sa or an administrator account)
DB_ENGINE=mssql
DB_HOST=SERVERSYSTEM
DB_PORT=
DB_NAME=TaskManagement_Production
DB_USER=taskmanagement_app
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
