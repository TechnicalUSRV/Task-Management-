# Frontend build settings. Copy to source/.env if you need to change them (source/.env is git-ignored).
# Only variables starting with VITE_ end up in the browser bundle, so never put a password or token here.

# Where the React app sends API requests. Leave empty (recommended) when Django serves the built app itself
# (python manage.py runserver after npm run build) or when you use the dev server below: the app then calls its own origin.
# Set it only when the API runs on another address, e.g. VITE_API_BASE_URL=https://tasks-api.example.com — that address
# must then list this app's origin in DJANGO_TRUSTED_ORIGINS (backend/.env).
VITE_API_BASE_URL=

# npm run dev: the Vite dev server (http://127.0.0.1:5173) forwards /c/<company>/api/… to this Django address.
DEV_BACKEND_URL=http://127.0.0.1:8000
